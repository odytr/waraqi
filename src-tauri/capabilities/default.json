{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Waraqi permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",

    "opener:default",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",

    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/library/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/library" },
        { "path": "$APPDATA/library/**" }
      ]
    }
  ]
}