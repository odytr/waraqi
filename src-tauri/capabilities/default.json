{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Waraqi permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",

    "dialog:default",
    "dialog:allow-open",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",

    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    }
  ]
}